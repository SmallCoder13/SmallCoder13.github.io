from pathlib import Path

def whl_to_html():
    package_name = input("Enter the package name: \n")

    if not Path("simple", "index.html").exists():
        Path("simple", "index.html").write_text("")

    if package_name in Path("simple", "index.html").read_text():
        print("Package already saved")
        return None

    else:
        with open(Path("simple", "index.html"), mode="a") as package_file:
            package_file.write(f"<a href={package_name}/index.html>{package_name}<a/> <br/>")

    for whl_filepath in Path("files", package_name).iterdir():
        if whl_filepath.is_dir():
            continue

        print(f"Saving whl file {whl_filepath.as_posix()}...")
    
        whl_filename = whl_filepath.as_posix().replace(f"files/{package_name}", "")[1:]
        html_folder = Path("simple", package_name)
        html_filepath = Path(html_folder, "index.html")

        html_folder.mkdir(exist_ok=True)

        if not html_filepath.exists():
            html_filepath.write_text("")

        with open(html_filepath, mode="a") as html_file:
            html_file.write(f"<a href=../../files/{package_name}/{whl_filename}>{whl_filename}<a/> <br/>")

if __name__ == "__main__":
    whl_to_html()
